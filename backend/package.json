    "passport-local-mongoose": "^8.0.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.2.2",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "core-js@3.49.0": true
