    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "connect-mongo": "^4.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.2",
    "file-type": "^22.1.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "js-yaml": "^4.2.0",
    "method-override": "^3.0.0",
    "mongoose": "^7.6.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1",
    "otplib": "^13.5.0",
