{
  "engines": {
    "node": "24.16.0"
  },
  "name": "wander-lust",
  "version": "2.0.0",
  "description": "Wanderlust — Travel Listing Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seedDatabase.js",
    "migrate:001": "node migrations/001_user_profile_fields.js",
    "migrate:002": "node migrations/002_listing_airbnb_fields.js",
    "migrate:003": "node migrations/003_password_reset_tokens.js",
    "migrate:004": "node migrations/004_email_verification_tokens.js",
    "migrate:005": "node migrations/005_search_indexes.js",
    "migrate:006": "node migrations/006_review_upgrade.js",
    "migrate:007": "node migrations/007_wishlist_collections.js",
    "migrate:008": "node migrations/008_reports.js",
    "test": "node tests/rbac.test.js",
    "test:email-verification": "node tests/emailVerification.test.js",
    "test:booking": "vitest run tests/booking.lifecycle.test.js",
    "test:booking:concurrency": "vitest run tests/booking.concurrency.test.js",
    "test:upload": "vitest run tests/security/upload.security.test.js",
    "test:all": "npm run test && npm run test:email-verification && npm run test:security && npm run test:booking && npm run test:booking:concurrency && npm run test:upload",
    "validate:api": "node src/scripts/validate-openapi.js"
  },
